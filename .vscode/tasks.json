      "problemMatcher": [],
      "presentation": { "group": "lab34", "panel": "dedicated" }
    },
    {
      "label": "Lab 3 & 4: POI MCP server (port 3001)",
      "type": "shell",
      "command": "pnpm dev",
      "options": { "cwd": "${workspaceFolder}/workshop/lab3_lab4/packages/mcp-poi" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "group": "lab34", "panel": "dedicated" }
    },
    {
      "label": "Lab 3 & 4: Weather MCP server (port 3002)",
      "type": "shell",
